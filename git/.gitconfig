# ~/.gitconfig — portable across machines/jobs.
# Identity lives in ~/.gitconfig.local (NOT tracked) so you never commit with
# the wrong email at a new job. The installer writes it for you.
[include]
	path = ~/.gitconfig.local

[core]
	excludesFile = ~/.gitignore
	pager = delta

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[fetch]
	prune = true

[rebase]
	autoStash = true

[diff]
	colorMoved = default
	algorithm = histogram
	tool = hunk

[merge]
	conflictstyle = zdiff3

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false

# hunk (hunk.dev) — review-first diff viewer, alongside delta.
# delta stays the default pager; reach for hunk explicitly:
#   git hdiff      review the working tree in hunk
#   git hshow HEAD review a commit in hunk
#   git difftool   diff via hunk
[difftool]
	prompt = false
[difftool "hunk"]
	cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"

[column]
	ui = auto

[branch]
	sort = -committerdate

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[log]
	date = iso

# Commit signing is machine/job-specific — enable it in ~/.gitconfig.local:
#   [user]    signingkey = ~/.ssh/id_ed25519.pub
#   [gpg]     format = ssh
#   [commit]  gpgsign = true

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	ci = commit
	amend = commit --amend --no-edit
	last = log -1 HEAD --stat
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) %C(dim white)%an%C(reset) %C(auto)%d%C(reset) %s %C(dim)(%ar)%C(reset)'
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	wip = "!git add -A && git commit -m 'wip'"
	cleanup = "!git branch --merged | grep -vE '^\\*|master|main|develop' | xargs -r git branch -d"
	hdiff = -c core.pager=hunk\\ pager diff
	hshow = -c core.pager=hunk\\ pager show
