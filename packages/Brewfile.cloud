# Brewfile.cloud — cloud & infra tooling (optional group).
# Note: kubectl, kubectx, terraform, terragrunt, helm come pinned via mise.

brew "awscli"
brew "aws-vault"       # secure AWS credential storage
brew "sops"            # encrypted secrets
brew "mkcert"          # locally-trusted dev certs
brew "minica"          # minimal CA
brew "ykman"           # YubiKey manager
brew "railway"         # Railway deploys
