// Zed settings — this file is a TEMPLATE, not the live config.
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// ⚠ SECRETS & PATHS: Zed has no env-var interpolation in settings.json, so
// `just link` (install.sh) renders this file through `envsubst` into
// ~/.config/zed/settings.json, filling in the ${ZED_*} secret placeholders
// (export them in ~/.zshrc.local) and ${HOME} for portable per-machine
// paths. The rendered file is the real one Zed reads/writes — edit THIS
// repo file for structural changes, then re-run `just link` to re-render.
{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "context_servers": {
    "postgres-context-server": {
      "enabled": true,
      "settings": {
        "database_url": "${ZED_DATABASE_URL}"
      }
    },
    "mcp-server-github": {
      "enabled": true,
      "settings": {
        "github_personal_access_token": "${ZED_GITHUB_PAT}"
      }
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context7_api_key": "${ZED_CONTEXT7_API_KEY}"
      }
    }
  },
  "prettier": {
    "allowed": true
  },
  "search": {
    "center_on_match": true,
    "include_ignored": true
  },
  "project_panel": {
    "dock": "left",
    "default_width": 240.0
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Latte"
  },
  "enable_language_server": true,
  "buffer_font_family": "MesloLGL Nerd Font",
  "ui_font_size": 12.0,
  "buffer_font_size": 11,
  "ui_font_family": "MesloLGL Nerd Font Mono",
  "terminal": {
    "font_family": "MesloLGL Nerd Font Mono",
    "font_size": 11.0
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula"
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "!solargraph",
        "rubocop",
        "!sorbet",
        "!steep",
        "!kanayago",
        "..."
      ]
    }
  },
  "lsp": {
    "fuzzy-ruby-server": {
      "binary": {
        "path": "${HOME}/.cargo/bin/fuzzy"
      }
    },
    "ruby-lsp": {
      "binary": {
        "path": "${HOME}/.local/share/mise/shims/ruby-lsp"
      }
    }
  }
}
