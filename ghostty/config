# Configuration file for Ghostty (~/.config/ghostty/config)
# Ghostty uses a simple 'key = value' format.

# Basics
theme = "MOSS"
font-family = "Fira Code"
font-size = 13

# Shift + Enter = new line
keybind = shift+enter=text:\x1b\r

# Move between panes within tab
keybind = alt+shift+h=goto_split:left
keybind = alt+shift+j=goto_split:bottom
keybind = alt+shift+k=goto_split:top
keybind = alt+shift+l=goto_split:right

# Resize panes
keybind = alt+shift+left=resize_split:left,50
keybind = alt+shift+down=resize_split:down,50
keybind = alt+shift+up=resize_split:up,50
keybind = alt+shift+right=resize_split:right,50
keybind = alt+shift+space=equalize_splits

# Machine-specific overrides (window geometry, font size…) live in an
# untracked `local` file next to this one — see .gitignore. The leading `?`
# makes it optional, so a fresh machine works without it. Loaded last: wins.
config-file = ?local

# Quick Terminal
quick-terminal-position = top
quick-terminal-size= 70%
quick-terminal-screen = main
quick-terminal-autohide = true
quick-terminal-animation-duration=0.25
keybind = global:opt+`=toggle_quick_terminal

# Tracked in the repo next to this file, so it works on every machine.
background-image="~/.config/ghostty/hallstatt.jpg"
background-image-fit=cover
background-image-opacity=0.08